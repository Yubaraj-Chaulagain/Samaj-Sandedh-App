<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F4F7F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="समाज सन्देश"
        android:textSize="27sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#0F766E"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/radioTab"
            android:text="📻 Radio"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/tvTab"
            android:text="📺 Live TV"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"/>
    </LinearLayout>

    <EditText
        android:id="@+id/search"
        android:hint="Radio / TV खोज्नुहोस्..."
        android:singleLine="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Spinner
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/nowPlaying"
        android:text="📻 Radio Player"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="18dp"
        android:textColor="#0F766E"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.media3.ui.PlayerControlView
        android:id="@+id/audioControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:show_timeout="0"/>

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:show_buffering="when_playing"
        app:use_controller="true"/>

    <TextView
        android:id="@+id/status"
        android:text="Radio छान्नुहोस्"
        android:gravity="center"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/play"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="▶ Play"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/stop"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="■ Stop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</LinearLayout>
